# Copy this file as .env and paste your TEST keys (they start with sk_test_ / pk_test_)
# You can find them at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_paste_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_paste_your_publishable_key_here

# Printed by the `stripe listen` command (optional step to see webhooks)
STRIPE_WEBHOOK_SECRET=whsec_paste_the_webhook_secret_here

PORT=3000

# Optional: SQLite file (default data/demo.db)
# DATABASE_PATH=data/demo.db
