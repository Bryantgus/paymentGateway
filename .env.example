# Copia este archivo como .env y pega tus claves de PRUEBA (empiezan con sk_test_ / pk_test_)
# Las encuentras en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_pega_tu_clave_secreta_aqui
STRIPE_PUBLISHABLE_KEY=pk_test_pega_tu_clave_publicable_aqui

# Lo entrega el comando `stripe listen` (paso opcional para ver webhooks)
STRIPE_WEBHOOK_SECRET=whsec_pega_el_secreto_del_webhook_aqui

PORT=3000
